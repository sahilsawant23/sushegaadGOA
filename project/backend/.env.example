# Backend Environment Variables Blueprint

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MySQL / Aiven / cPanel Database)
DB_HOST=your-mysql-host.com
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=goa_db
DB_PORT=3306
DB_SSL=false

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Production Allowed Frontend Domain for CORS
CORS_ORIGIN=https://your-domain.com

# Email Service Credentials (Nodemailer / Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Razorpay Payment Gateway Keys
RAZORPAY_KEY_ID=rzp_test_TDstsI3dZOt2yf
RAZORPAY_KEY_SECRET=your_razorpay_secret

# AI & Third Party API Keys
GEMINI_API_KEY=your_gemini_api_key
TICKETMASTER_API_KEY=your_ticketmaster_key
RAPIDAPI_KEY=your_rapidapi_key

# Webhook Automations (Optional)
N8N_BOOKING_WEBHOOK_URL=http://localhost:5678/webhook-test/booking-confirmed
N8N_CONTACT_WEBHOOK_URL=http://localhost:5678/webhook-test/contact-inquiry
